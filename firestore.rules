rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // All players can read profiles for multiplayer leaderboards, clan rosters, and harbor visits
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId);
    }

    // TRIBES COLLECTION
    // Allows viewing, creating, joining, leaving, and donating to clans
    match /tribes/{tribeId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    // CHATS COLLECTION
    match /chats/{chatId} {
      allow read, write: if true;
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    // SUPPORT TICKETS
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // HARBOR EVENTS & NOTIFICATIONS
    match /harborEvents/{eventId} {
      allow read, write: if true;
    }

    match /globalNotifications/{notifId} {
      allow read, write: if true;
    }

    // TEST CONNECTION
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
